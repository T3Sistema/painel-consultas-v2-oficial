# Chave (header X-API-Key) da DabraData (https://app.dabradata.com) usada
# pela function api/consulta-empresa.ts (proxy same-origin) para consultar
# CNPJ/QSA (cadastro-pj-plus). Lida só no servidor (process.env) — nunca
# pelo código do navegador, nunca aparece no bundle nem em mensagens de erro.
# Copie este arquivo para ".env" e preencha com sua chave real.
DABRADATA_API_KEY=
# Nome anterior — ainda aceito como reserva se DABRADATA_API_KEY estiver vazia.
# FONTEDATA_API_KEY=

# Valor completo do header Authorization exigido pela APIFull
# (https://apifull.com.br) para o endpoint cpf-ultra, usado pela function
# api/cpf-ultra.ts. Use exatamente o valor fornecido pela APIFull — a
# function NÃO adiciona "Bearer " automaticamente. Lida só no servidor.
#
# /api/cpf-ultra e /api/cadastro-pj-plus exigem sessão autenticada (ver
# api/_lib/auth.ts) — configure também SUPABASE_URL/SUPABASE_SECRET_KEY
# abaixo antes de usar em produção.
APIFULL_AUTHORIZATION=

# Projeto Supabase usado só como Postgres + Storage — login e sessões são
# tabelas próprias (ver supabase/migrations/), NÃO Supabase Auth. Lidas só
# no servidor (process.env) — nunca use prefixo VITE_* para estas duas.
SUPABASE_URL=

# Service Role Key do Supabase (Project Settings → API). NUNCA a "anon"
# key — a service role ignora RLS e por isso só pode ser usada no servidor.
SUPABASE_SECRET_KEY=
